      "item": [
        {
          "name": "Criar cadastro (sucesso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.test('devolve uuid e resume_token', () => {",
                  "  pm.expect(data.uuid).to.be.a('string');",
                  "  pm.expect(data.resume_token).to.have.lengthOf(64);",
                  "});",
                  "pm.test('não expõe a senha', () => pm.expect(data.personal_data).to.not.have.property('password'));",
                  "pm.collectionVariables.set('opening_uuid', data.uuid);",
                  "pm.collectionVariables.set('opening_token', data.resume_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Maria da Silva\",\n  \"email\": \"maria.silva@example.com\",\n  \"password\": \"SenhaForte@123\",\n  \"password_confirmation\": \"SenhaForte@123\",\n  \"cpf\": \"529.982.247-25\",\n  \"document_type\": \"rg\",\n  \"document_number\": \"12.345.678-9\",\n  \"document_issuer\": \"SSP\",\n  \"document_issuer_uf\": \"SP\",\n  \"birth_date\": \"1990-05-10\",\n  \"phone\": \"(11) 98888-7777\",\n  \"domain\": \"novabank.com.br\"\n}",
